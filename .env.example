# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.rgconstructiontx.com

# --- Resend: powers the estimate & contact forms ---
# 1. Create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 2. Where form submissions are delivered (defaults to this if unset)
ESTIMATE_TO_EMAIL=rgconstructionserv@gmail.com

# 3. The "From" address. Must be on a domain you've verified in Resend
#    (https://resend.com/domains). For quick testing you can use
#    "onboarding@resend.dev" — but verify your own domain for production
#    so emails land reliably and aren't flagged as spam.
RESEND_FROM_EMAIL=RG Construction <estimates@rgconstructiontx.com>

# --- Google Analytics 4 (optional) ---
# Your GA4 Measurement ID. Analytics loads only when this is set.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
